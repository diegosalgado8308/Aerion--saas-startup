generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum EconomyNodeType {
  POOL
  SOURCE
  DRAIN
  CONVERTER
}

model Workspace {
  id         String    @id @default(cuid())
  name       String
  inviteCode String    @unique @default(cuid())
  createdAt  DateTime  @default(now())

  members    User[]
  projects   Project[]
}

model User {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  password    String
  role        Role      @default(MEMBER)
  createdAt   DateTime  @default(now())

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Stores sha256(rawToken), never the raw token itself — same reason
  // passwords are hashed, not stored plain. Unlike bcrypt, sha256 is
  // deterministic, which is what makes a direct @unique lookup possible;
  // that's fine here because the raw token is 256 bits of crypto.randomBytes,
  // not a low-entropy human password, so sha256's speed isn't a brute-force
  // liability the way it would be for a password column.
  resetTokenHash      String?   @unique
  resetTokenExpiresAt DateTime?

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  assignedTasks Task[]  @relation("TaskAssignee")
  comments      Comment[]
  attachments   Attachment[]

  @@index([workspaceId])
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())

  goalFramework    String?
  goalStageValues  Json    @default("{}")

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  tasks       Task[]
  economyDiagrams EconomyDiagram[]

  @@index([workspaceId])
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  dueReminderSentAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId  String?
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  comments    Comment[]
  attachments Attachment[]

  @@index([projectId])
  @@index([assigneeId])
}

model Attachment {
  id        String   @id @default(cuid())
  filename  String
  url       String
  size      Int
  createdAt DateTime @default(now())

  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  uploaderId String?
  uploader   User?   @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([uploaderId])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([authorId])
}

model EconomyDiagram {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  nodes       EconomyNode[]
  connections EconomyConnection[]
  layers      EconomyLayer[]

  @@index([projectId])
}

model EconomyLayer {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#6366f1")
  order     Int      @default(0)
  createdAt DateTime @default(now())

  diagramId String
  diagram   EconomyDiagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)

  nodes     EconomyNode[]

  @@index([diagramId])
}

model EconomyNode {
  id           String          @id @default(cuid())
  name         String
  type         EconomyNodeType
  resourceName String
  initialValue Float           @default(0)
  capacity     Float?
  createdAt    DateTime        @default(now())

  diagramId    String
  diagram      EconomyDiagram  @relation(fields: [diagramId], references: [id], onDelete: Cascade)

  layerId      String?
  layer        EconomyLayer?   @relation(fields: [layerId], references: [id], onDelete: SetNull)

  outgoing     EconomyConnection[] @relation("FromNode")
  incoming     EconomyConnection[] @relation("ToNode")

  @@index([diagramId])
  @@index([layerId])
}

model EconomyConnection {
  id           String         @id @default(cuid())
  rate         Float
  rateVariance Float          @default(0)
  createdAt    DateTime       @default(now())

  diagramId    String
  diagram      EconomyDiagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)

  fromNodeId   String
  fromNode     EconomyNode    @relation("FromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)

  toNodeId     String
  toNode       EconomyNode    @relation("ToNode", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@index([diagramId])
  @@index([fromNodeId])
  @@index([toNodeId])
}
